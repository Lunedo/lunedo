{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": ["biome.json", "packages/config/tsconfig/*.json", ".github/workflows/ci.yml"],
  "globalPassThroughEnv": [
    "CI_PARALLELISM",
    "CI_RETRIES",
    "PAGEHALL_PARALLELISM",
    "PAGEHALL_TEST_WORKERS",
    "PAGEHALL_E2E_WORKERS",
    "PAGEHALL_TEST_REPORT_DIR",
    "GITHUB_WORKSPACE",
    "GOMAXPROCS",
    "RAYON_NUM_THREADS",
    "GITHUB_ENV",
    "GITHUB_EVENT_NAME",
    "GITHUB_EVENT_PATH",
    "GITHUB_OUTPUT",
    "GITHUB_SHA",
    "GITHUB_STEP_SUMMARY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "PAGEHALL_TEST_DATABASE_URL",
        "PAGEHALL_TEST_MAILPIT_URL",
        "PAGEHALL_TEST_MAILPIT_SMTP_PORT",
        "PAGEHALL_TEST_REDIS_URL",
        "PAGEHALL_TEST_S3_ENDPOINT"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PAGEHALL_*"]
    }
  }
}
