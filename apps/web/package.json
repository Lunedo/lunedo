  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../api/openapi.json -o src/api/generated/schema.d.ts --silent",
    "build": "pnpm api:types && vite build",
    "build:e2e": "pnpm api:types && vite build --mode e2e",
    "dev": "pnpm api:types && vite",
    "preview": "vite preview",
    "typecheck": "pnpm api:types && tsc --noEmit",
    "test": "pnpm api:types && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
