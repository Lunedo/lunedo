{
  "name": "@lunedo/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-docs-assets.mjs",
    "dev": "lunedo-dev --start dist/main.js --watch src --watch node_modules/@lunedo/shared/dist --watch node_modules/@lunedo/server/dist",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "node --enable-source-maps dist/openapi/write.js openapi.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@lunedo/server": "workspace:*",
    "@lunedo/shared": "workspace:*",
    "@lunedo/tokens": "workspace:*",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@lunedo/config": "workspace:*",
    "@scalar/api-reference": "^1.75.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "otpauth": "^9.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "files": [
    "dist"
  ]
}
