{
  "realm": "pagehall",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "groups": [
    {
      "id": "6f1c2b8e-3a4d-4c5e-9f60-7a8b9c0d1e2f",
      "name": "engineering",
      "path": "/engineering",
      "attributes": { "pagehall_group_id": ["6f1c2b8e-3a4d-4c5e-9f60-7a8b9c0d1e2f"] }
    },
    {
      "id": "0b9a8c7d-6e5f-4a3b-8c2d-1e0f9a8b7c6d",
