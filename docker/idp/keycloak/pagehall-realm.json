      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "pagehall-test-password", "temporary": false }],
      "groups": ["/engineering", "/admins"]
    },
    {
      "id": "b0b00000-0000-4000-8000-000000000002",
      "username": "bob",
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "pagehall-test-password", "temporary": false }],
      "groups": ["/engineering"]
    },
    {
      "id": "ca401000-0000-4000-8000-000000000003",
      "username": "carol",
      "email": "carol@example.org",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "pagehall-test-password", "temporary": false }],
      "groups": []
    },
    {
      "id": "da7e0000-0000-4000-8000-000000000004",
      "username": "dave",
      "email": "dave@example.org",
      "emailVerified": true,
      "firstName": "Dave",
