      "credentials": [{ "type": "password", "value": "pagehall-test-password", "temporary": false }],
      "groups": ["/engineering"]
    },
    {
      "id": "e4140000-0000-4000-8000-000000000005",
      "username": "erin",
      "email": "erin@example.net",
      "emailVerified": true,
