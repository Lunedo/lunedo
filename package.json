{
  "name": "pagehall",
  "private": true,
  "description": "Self-hosted wiki, knowledge base and project planning tool",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.20 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:down": "docker compose -f docker/compose.dev.yml --profile idp down",
    "dev:idp": "docker compose -f docker/compose.dev.yml --profile idp up --detach --wait keycloak authentik-server authentik-worker openldap",
    "dev:reset": "node scripts/reset-dev.ts",
    "dev:apps": "turbo run dev --concurrency=20",
    "build": "turbo run build",
    "lint": "biome ci . && node scripts/eslint.ts",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && node scripts/run-turbo.ts run typecheck --continue",
    "test": "node --test \"scripts/*.test.ts\" && node scripts/run-turbo.ts run test --continue",
    "test:e2e": "turbo run test:e2e",
    "licenses:check": "node scripts/check-licenses.ts",
    "dco:check": "node scripts/check-dco.ts",
    "prepare": "node scripts/install-hooks.ts",
    "lint:fix": "biome check --write .",
    "references:check": "node scripts/check-private-references.ts",
    "patches:check": "node scripts/check-patches.ts",
    "playwright-image:check": "node scripts/check-playwright-image.ts",
    "i18n:check": "node scripts/check-i18n.ts",
    "shell:check": "node scripts/check-shell.ts",
    "release-jobs:check": "node scripts/check-release-jobs.ts",
    "container-users:check": "node scripts/check-container-users.ts",
    "verify": "node scripts/verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.13.0",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
