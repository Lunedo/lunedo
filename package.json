{
  "name": "pagehall",
  "private": true,
  "description": "Self-hosted wiki, knowledge base and project planning tool",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "docker compose -f docker/compose.dev.yml up --build",
    "dev:down": "docker compose -f docker/compose.dev.yml down",
    "dev:apps": "turbo run dev --concurrency=20",
    "build": "turbo run build",
    "lint": "biome ci . && eslint",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "node --test \"scripts/*.test.ts\" && turbo run test",
    "test:e2e": "turbo run test:e2e",
    "licenses:check": "node scripts/check-licenses.ts",
    "dco:check": "node scripts/check-dco.ts",
    "prepare": "node scripts/install-hooks.ts",
    "lint:fix": "biome check --write .",
    "references:check": "node scripts/check-private-references.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "turbo": "^2.11.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
