      "mono": "'Geist Mono', ui-monospace, monospace",
      "readable": "'Atkinson Hyperlegible Next', system-ui, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "content": "1rem",
      "lg": "1.25rem",
      "xl": "1.625rem",
      "2xl": "2rem"
    },
    "lineHeight": { "tight": 1.2, "ui": 1.45, "content": 1.65 },
    "letterSpacing": { "heading": "-0.015em", "label": "0.05em" }
  },
  "accentShare": { "light": { "soft": 0.09, "selected": 0.14 }, "dark": { "soft": 0.09, "selected": 0.24 } },
  "textScale": { "min": 0.875, "default": 1, "max": 1.25, "steps": [0.875, 0.9375, 1, 1.125, 1.25] },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": { "sm": "0.375rem", "md": "0.5rem", "lg": "0.75rem", "full": "9999px" },
  "shadow": {
    "card": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "popover": "0 10px 30px rgba(0, 0, 0, 0.12)",
    "dialog": "0 20px 50px rgba(0, 0, 0, 0.20)"
  },
  "layout": {
    "railWidth": "3.75rem",
    "sidebarWidth": "16.5rem",
    "toolbarHeight": "3.25rem",
    "contentWidth": "47.5rem",
    "rowHeight": { "default": "1.875rem", "compact": "1.75rem" },
    "control": { "sm": "1.75rem", "md": "2rem", "lg": "2.5rem", "field": "2.25rem" },
    "controlCompact": { "sm": "1.5rem", "md": "1.75rem", "lg": "2.25rem", "field": "2rem" },
    "cardWidth": "25rem",
    "cardWidthWide": "40rem",
    "pageWidth": "56rem",
    "panelWidth": "22.5rem",
    "dialogWidth": { "sm": "28rem", "md": "32rem", "lg": "40rem" },
    "qrCodeSize": "7.5rem",
    "fieldWidth": "16rem",
    "numberFieldWidth": "6rem",
    "unitFieldWidth": "9rem"
  },
  "focusRing": { "width": "0.125rem", "widthHighContrast": "0.1875rem", "offset": "0.125rem" },
  "icon": {
    "library": "lucide",
    "strokeWidth": 1.75,
    "size": { "sm": "0.875rem", "md": "1rem", "lg": "1.25rem" }
  }
