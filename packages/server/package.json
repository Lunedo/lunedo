{
  "name": "@lunedo/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "@lunedo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@lunedo/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/global-setup": {
      "@lunedo/source": "./src/testing/global-setup.ts",
      "types": "./dist/testing/global-setup.d.ts",
      "default": "./dist/testing/global-setup.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "lunedo-dev",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "drizzle",
    "data"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@node-saml/node-saml": "^5.1.0",
    "@lunedo/editor-schema": "workspace:*",
    "@lunedo/shared": "workspace:*",
    "@lunedo/tokens": "workspace:*",
    "@peculiar/x509": "^2.2.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.12.0",
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "js-yaml": "^5.5.0",
    "ldapts": "^9.2.0",
    "lucide": "^1.59.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rrule-temporal": "^2.2.8",
    "sharp": "^0.35.5",
    "tar-stream": "^3.2.2",
    "temporal-polyfill": "^1.0.6",
    "ua-parser-js": "^2.0.10",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lunedo/config": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.5",
    "@types/xml-encryption": "^1.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "xml-crypto": "^6.4.0",
    "xml-encryption": "^6.0.2"
  }
}
