{
  "name": "@pagehall/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "@pagehall/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@pagehall/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/global-setup": {
      "@pagehall/source": "./src/testing/global-setup.ts",
      "types": "./dist/testing/global-setup.d.ts",
      "default": "./dist/testing/global-setup.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pagehall-dev",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "dependencies": {
    "@pagehall/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tar-stream": "^3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pagehall/config": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
