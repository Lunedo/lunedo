{
  "name": "@pagehall/editor-schema",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "@pagehall/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./yjs": {
      "@pagehall/source": "./src/yjs.ts",
      "types": "./dist/yjs.d.ts",
      "default": "./dist/yjs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pagehall-dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pagehall/config": "workspace:*",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tiptap/y-tiptap": "3.0.9",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "sideEffects": false
}
